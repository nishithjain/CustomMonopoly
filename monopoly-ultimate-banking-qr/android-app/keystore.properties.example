# Copy to keystore.properties and fill in values for a production-signed release APK.
# keystore.properties is gitignored — do not commit secrets.
#
# Generate a keystore (one-time):
#   keytool -genkeypair -v -keystore release.keystore -alias boardbanker \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=release.keystore
storePassword=change-me
keyAlias=boardbanker
keyPassword=change-me
